@using Microsoft.AspNetCore.Identity
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Asian Food Restaurant</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,600;9..144,700&family=Work+Sans:wght@400;500;600&family=JetBrains+Mono:wght@400;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark">
        <div class="container-fluid">
            <a class="navbar-brand" asp-controller="Home" asp-action="Index">🥢 Asian Food Restaurant</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#nav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="nav">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">🏮Home</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Menu"> 🍽️Menu</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Ratings">⭐Ratings</a></li>
                    

                  
                    
                    

                    @if (SignInManager.IsSignedIn(User))
                    {
                        if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="Admin" asp-action="Dashboard">Dashboard</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Admin" asp-action="Menu">Manage Menu</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Admin" asp-action="Stock">Stock</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Admin" asp-action="Orders">Orders</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Admin" asp-action="Employees">Employees</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Admin" asp-action="Customers">Customers</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Admin" asp-action="Complaints">Complaints</a></li>
                          
                            <li class="nav-item"><a class="nav-link" asp-controller="Admin" asp-action="Refunds">Refunds</a></li>
                        
                        }
                        else if (User.IsInRole("Employee"))
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="Employee" asp-action="Dashboard">Available Orders</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Employee" asp-action="MyOrders">My Orders</a></li>
                        }
                        else if (User.IsInRole("Customer"))
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="Customer" asp-action="Cart">🛒Cart</a></li>
                          
                            <li class="nav-item"><a class="nav-link" asp-controller="Customer" asp-action="MyOrders">📦 My Orders</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Customer" asp-action="Complaints">📩 Complaints</a></li>
                        }
                    }
                </ul>
                <ul class="navbar-nav">
                    @if (SignInManager.IsSignedIn(User))
                    {
                        <li class="nav-item"><span class="nav-link text-white-50">Hi, @User.Identity!.Name</span></li>
                        <li class="nav-item">
                            <form asp-controller="Account" asp-action="Logout" method="post">
                                <button type="submit" class="btn btn-outline-light btn-sm mt-1">Logout</button>
                            </form>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item"><a class="nav-link" asp-controller="Account" asp-action="Login">Login</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Account" asp-action="Register">Register</a></li>
                    }
                </ul>
            </div>
        </div>
    </nav>

    <div class="container mt-4 page-content">
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success">@TempData["Success"]</div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger">@TempData["Error"]</div>
        }
        @RenderBody()
    </div>

 

    <footer class="text-center">
        &copy; @DateTime.Now.Year - Asian Food Restaurant

        @if (ViewContext.RouteData.Values["controller"]?.ToString() == "Home"
             && ViewContext.RouteData.Values["action"]?.ToString() == "Index")
        {
            <div class="text-center px-3 small mt-1">
                Connect Us
                <br>
                📍 123 Gulshan Avenue, Dhaka 1212, Bangladesh
                <br>
                📞 +8801722365487
                <br>
                Email: asianfood@gmail.com
            </div>
        }
    </footer>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
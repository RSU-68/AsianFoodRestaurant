@model List<Order>
@{ ViewData["Title"] = "Available Orders"; }

<h2>Orders Accepted by Admin (Unclaimed)</h2>

@if (!Model.Any())
{
    <p>No orders available to claim right now.</p>
}
else
{
    <table class="table bg-white align-middle">
        <thead><tr><th>#</th><th>Customer</th><th>Items</th><th>Total</th><th></th></tr></thead>
        <tbody>
            @foreach (var order in Model)
            {
                <tr>
                    <td>@order.Id</td>
                    <td>@order.Customer?.FullName</td>
                    <td>@string.Join(", ", order.OrderItems.Select(i => $"{i.MenuItemName} x{i.Quantity}"))</td>
                    <td>৳@order.TotalAmount.ToString("0.00")</td>
                    <td>
                        <form asp-action="ClaimOrder" method="post">
                            <input type="hidden" name="id" value="@order.Id" />
                            <button class="btn btn-sm btn-danger" type="submit">Claim Order</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@model List<MenuItem>
@{
    ViewData["Title"] = "Home";
}

<div class="hero">
    <div class="row align-items-center">
        <div class="col-lg-7">
            <p class="eyebrow" style="color:var(--color-gold);">Pan-Asian </p>
            <h1>Wok-fired flavor, delivered before it cools.</h1>
            <p class="lead mt-3 mb-4">Noodles, curries, and street-food classics from across Asia — ordered in a minute, out of the kitchen fast.</p>
            

            
            <form asp-controller="Home" asp-action="Menu" method="get" class="hero-search d-flex gap-2 mb-3">
                <input type="text" name="search" class="form-control form-control-lg" placeholder="Search Pad Thai, sushi, curry..." />
                <button type="submit" class="btn btn-lacquer btn-lg text-white px-4">🔍︎</button>
            </form>
            <a asp-controller="Home" asp-action="Menu" class="btn btn-gold">View Full Menu →</a>
        </div>

        <div class="col-lg-5 mt-5 mt-lg-0">
            <div id="heroCarousel" class="carousel slide carousel-fade hero-carousel" data-bs-ride="carousel" data-bs-interval="3000">
                <div class="carousel-inner">
                    <div class="carousel-item active">
                        <img src="https://images.deliveryhero.io/image/fd-bd/LH/t5xz-hero.jpg" class="hero-food-img" alt="Wok-fried noodles" />
                    </div>
                    <div class="carousel-item">
                        <img src="https://img-cdn.publive.online/fit-in/1200x675/sanjeev-kapoor/media/media_files/2025/08/05/fried-sushi-yt-2025-08-05-11-37-18.jpg" class="hero-food-img" alt="Asian curry bowl" />
                    </div>
                    <div class="carousel-item">
                        <img src="https://images.unsplash.com/photo-1617093727343-374698b1b08d?auto=format&fit=crop&w=900&q=80" class="hero-food-img" alt="Sushi platter" />
                    </div>
                </div>
                <button class="carousel-control-prev" type="button" data-bs-target="#heroCarousel" data-bs-slide="prev">
                    <span class="carousel-control-prev-icon"></span>
                </button>
                <button class="carousel-control-next" type="button" data-bs-target="#heroCarousel" data-bs-slide="next">
                    <span class="carousel-control-next-icon"></span>
                </button>
                <div class="carousel-indicators">
                    <button type="button" data-bs-target="#heroCarousel" data-bs-slide-to="0" class="active"></button>
                    <button type="button" data-bs-target="#heroCarousel" data-bs-slide-to="1"></button>
                    <button type="button" data-bs-target="#heroCarousel" data-bs-slide-to="2"></button>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row mt-5 steps">
    <div class="col-12 mb-3">
        <p class="eyebrow">How it works</p>
        <h3>From order to doorstep</h3>
    </div>
    <div class="col-md-4 mb-3">
        <div class="step-num mb-1">01</div>
        <h5>Order 🚚</h5>
        <p class="text-muted">Browse the menu, add dishes to your cart, and check out with the payment method you prefer — card, mobile banking, or cash on delivery.</p>
    </div>
    <div class="col-md-4 mb-3">
        <div class="step-num mb-1">02</div>
        <h5>The kitchen fires it up 🫕</h5>
        <p class="text-muted">Our team accepts your order and an employee claims it, marking it "Preparing" the moment it hits the wok.</p>
    </div>
    <div class="col-md-4 mb-3">
        <div class="step-num mb-1">03</div>
        <h5> Refund Policy 💰 </h5>
        <p class="text-muted">After accepting the order, if you cancel it, you will receive a 20% refund.</p>
    </div>
   
</div>

<div class="text-center my-5">
    @if (User.Identity?.IsAuthenticated != true)
    {
        <a asp-controller="Account" asp-action="Register" class="btn btn-lacquer text-white btn-lg px-4 me-2">Create an Account</a>
    }

</div>
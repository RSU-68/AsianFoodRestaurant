@model MenuItemFormViewModel
@{ ViewData["Title"] = "Add Menu Item"; }

<h2>Add Menu Item</h2>
<div class="row">
    <div class="col-md-6">
        <form asp-action="CreateMenuItem" method="post" enctype="multipart/form-data">
            <div asp-validation-summary="All" class="text-danger"></div>
            <div class="mb-3">
                <label class="form-label">Name</label>
                <input asp-for="Name" class="form-control" />
            </div>
            <div class="mb-3">
                <label class="form-label">Category</label>
                <input asp-for="Category" class="form-control" placeholder="e.g. Sushi, Noodles, Curry" />
            </div>
            <div class="mb-3">
                <label class="form-label">Description</label>
                <textarea asp-for="Description" class="form-control"></textarea>
            </div>
            <div class="mb-3">
                <label class="form-label">Price (৳)</label>
                <input asp-for="Price" class="form-control" type="number" step="0.01" />
            </div>
            <div class="mb-3">
                <label class="form-label">Stock Quantity</label>
                <input asp-for="StockQuantity" class="form-control" type="number" />
            </div>
            <div class="mb-3">
                <label class="form-label">Image</label>
                <input asp-for="ImageFile" class="form-control" type="file" accept="image/*" />
            </div>
            <button type="submit" class="btn btn-danger">Save</button>
        </form>
    </div>
</div>

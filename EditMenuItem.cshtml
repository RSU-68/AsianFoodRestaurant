@model MenuItemFormViewModel
@{ ViewData["Title"] = "Edit Menu Item"; }

<h2>Edit Menu Item</h2>
<div class="row">
    <div class="col-md-6">
        @if (!string.IsNullOrEmpty(Model.ExistingImagePath))
        {
            <img src="@Model.ExistingImagePath" width="150" class="mb-3 d-block" />
        }
        <form asp-action="EditMenuItem" method="post" enctype="multipart/form-data">
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="ExistingImagePath" />
            <div asp-validation-summary="All" class="text-danger"></div>
            <div class="mb-3">
                <label class="form-label">Name</label>
                <input asp-for="Name" class="form-control" />
            </div>
            <div class="mb-3">
                <label class="form-label">Category</label>
                <input asp-for="Category" class="form-control" />
            </div>
            <div class="mb-3">
                <label class="form-label">Description</label>
                <textarea asp-for="Description" class="form-control"></textarea>
            </div>
            <div class="mb-3">
                <label class="form-label">Price (৳)</label>
                <input asp-for="Price" class="form-control" type="number" step="0.01" />
            </div>
            <div class="mb-3">
                <label class="form-label">Stock Quantity</label>
                <input asp-for="StockQuantity" class="form-control" type="number" />
            </div>
            <div class="mb-3">
                <label class="form-label">Replace Image (optional)</label>
                <input asp-for="ImageFile" class="form-control" type="file" accept="image/*" />
            </div>
            <button type="submit" class="btn btn-danger">Update</button>
        </form>
    </div>
</div>

@model RequestRefundViewModel
@{
    ViewData["Title"] = "Request a Refund";
}

<h2>Request a Refund — Order #@Model.OrderId</h2>
<p class="text-muted">Tell us why you're requesting a refund. Our team will review and respond.</p>

<div class="row">
    <div class="col-md-6">
        <form asp-action="RequestRefund" method="post">
            <input type="hidden" asp-for="OrderId" />
            <div asp-validation-summary="All" class="text-danger"></div>

            <div class="mb-3">
                <label class="form-label">Reason for Refund</label>
                <textarea asp-for="Reason" class="form-control" rows="4" placeholder="e.g. Order never arrived, wrong items, food quality issue..."></textarea>
            </div>

            <button type="submit" class="btn btn-danger">Submit Refund Request</button>
            <a asp-action="MyOrders" class="btn btn-link">Cancel</a>
        </form>
    </div>
</div>
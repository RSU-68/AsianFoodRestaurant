@model List<MenuItem>
@{ ViewData["Title"] = "Stock Management"; }

<h2>Stock Management</h2>
<table class="table bg-white align-middle">
    <thead><tr><th>Item</th><th>Current Stock</th><th>Update</th></tr></thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @item.Name
                    @if (item.StockQuantity == 0)
                    {
                        <span class="badge bg-danger ms-2">Stock Out</span>
                    }
                </td>
                <td>@item.StockQuantity</td>
                <td>
                    <form asp-action="UpdateStock" method="post" class="d-flex gap-2">
                        <input type="hidden" name="id" value="@item.Id" />
                        <input type="number" name="stockQuantity" value="@item.StockQuantity" min="0" class="form-control" style="width:90px" />
                        <button class="btn btn-sm btn-danger" type="submit">Update</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
